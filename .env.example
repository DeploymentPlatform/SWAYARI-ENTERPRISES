# SWAYARI ENTERPRISES - Environment Configuration Template
# Copy this file to .dev.vars for local Wrangler Pages development (never commit .dev.vars or secrets!)

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# Authorised administrator email addresses (comma-separated allowlist)
ADMIN_EMAILS=swayarienterprises@gmail.com

# Google Identity Services (OAuth 2.0 Web Client ID)
# Obtain from Google Cloud Console under the swayarienterprises@gmail.com project
# Authorized Javascript Origins:
#   - http://localhost:8788
#   - https://swayari-enterprises.pages.dev
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Application Session Secret (at least 32 random characters for HMAC signatures)
SESSION_SECRET=your-random-32-byte-secret-do-not-share

# Cloudflare D1 Database ID (populated after running `wrangler d1 create swayari-db`)
D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# WhatsApp business contact number for manual customer discussions (international format without '+')
# Leave empty if pending business telephone registration
PUBLIC_WHATSAPP_NUMBER=

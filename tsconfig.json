{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@swayari/shared": ["packages/shared/src/index.ts"],
      "@swayari/shared/*": ["packages/shared/src/*"],
      "@swayari/server": ["packages/server/src/index.ts"],
      "@swayari/server/*": ["packages/server/src/*"],
      "@swayari/ui": ["packages/ui/src/index.ts"],
      "@swayari/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": ["packages", "apps", "scripts"]
}
